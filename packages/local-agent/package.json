  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@core/llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "vitest": "^4.1.9"
  }
}
