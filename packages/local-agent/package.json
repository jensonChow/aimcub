{
  "name": "@core/local-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable Node runtime adapters for authenticated local agent CLIs.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
