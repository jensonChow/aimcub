{
  "name": "@core/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral local persistence for aims/milestones/memories. Path-injected, async AimStore interface (so a Supabase adapter is a swap, not a rewrite). Shared by the desktop app and the CLI.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@core/domain": "workspace:*",
    "@core/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "vitest": "^4.1.9"
  }
}
