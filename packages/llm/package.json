{
  "name": "@core/llm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers": {
      "types": "./src/providers.ts",
      "default": "./src/providers.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live-providers": "vitest run --config scripts/vitest.live.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@core/domain": "workspace:*",
    "@core/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
