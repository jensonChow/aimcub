{
  "name": "@app/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Aimcub Mac desktop (Electron) — local-first Aim → decompose (with feedback step). Reuses the TS @core brain.",
  "author": "Aimcub",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac dmg zip",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@core/domain": "workspace:*",
    "@core/llm": "workspace:*",
    "@core/store": "workspace:*",
    "@core/types": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.aimcub.desktop",
    "productName": "Aimcub",
    "npmRebuild": false,
    "directories": { "output": "dist" },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "identity": null
    }
  }
}
